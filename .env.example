# Diese Datei nach `.env` kopieren und mit den eigenen Zugangsdaten ausfüllen.

OPENAI_API_KEY=

# Optionale LLM-Konfiguration
#
# Standardmäßig verwendet CogSim OpenAI mit dem Modell `gpt-4o-mini`.
#
# Alternativ kann auch ein anderer OpenAI-kompatibler Anbieter
# (z. B. ein lokal über Ollama bereitgestelltes Modell) verwendet werden.
# Dazu können bei Bedarf folgende Variablen gesetzt werden:
#
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional: ausführlichere Fehlermeldungen für die lokale Entwicklung.
# COGSIM_DEBUG=false

# Optional: Frontend mit Mockdaten starten.
# COGSIM_USE_MOCK_DATA=false